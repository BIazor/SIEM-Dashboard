# ---------------------------------------------------------------------------
# Aegis SOC platform configuration
# Copy to .env and replace every value marked CHANGE_ME. Never commit .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
LOG_LEVEL=info

# JWT signing key: at least 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_48_char_random_secret
ACCESS_TOKEN_TTL_MINUTES=60
LOGIN_RATE_LIMIT_PER_MINUTE=5

# Database (SQLite by default; any SQLAlchemy URL works, e.g. postgresql+psycopg://...)
DATABASE_URL=sqlite:///./data/soc.db

# Shared secret used by the Wazuh integration when posting alerts
INGEST_TOKEN=CHANGE_ME_generate_another_random_secret
# Optional comma-separated allow-list of source addresses for the webhook
INGEST_ALLOWED_IPS=
# Only enable behind a reverse proxy you control that overwrites X-Forwarded-For.
# When false (default) the header is ignored, so clients cannot spoof their address.
TRUST_PROXY_HEADERS=false

# Frontend origin(s) allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------- Demo accounts ---------------------------------
# Development/demo only. Never enable in production.
SEED_DEMO_USERS=false
SEED_ADMIN_EMAIL=admin@soc.local
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password
SEED_APPROVER_EMAIL=approver@soc.local
SEED_APPROVER_PASSWORD=CHANGE_ME_approver_password
SEED_ANALYST_EMAIL=analyst@soc.local
SEED_ANALYST_PASSWORD=CHANGE_ME_analyst_password
SEED_VIEWER_EMAIL=viewer@soc.local
SEED_VIEWER_PASSWORD=CHANGE_ME_viewer_password
